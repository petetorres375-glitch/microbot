# ===== Alpaca (use PAPER keys from https://app.alpaca.markets/paper/dashboard/overview) =====
ALPACA_API_KEY=your_paper_key_here
ALPACA_API_SECRET=your_paper_secret_here
LIVE_TRADING=false          # keep false for weeks. true = REAL money.

# ===== Risk =====
STARTING_EQUITY=500
RISK_PER_TRADE_PCT=0.01     # 1% of equity risked per trade
REWARD_RISK_RATIO=2.0       # 2:1 target:stop
MAX_OPEN_POSITIONS=4

# ===== Approval gate ("ask me first") =====
REQUIRE_LIVE_APPROVAL=true   # live trades queue for your yes/no (recommended)
PAPER_REQUIRE_APPROVAL=false # set true to practice the approval flow on paper

# ===== Universe & data =====
# Liquid, mostly lower-priced names so a $500 account can actually size positions.
UNIVERSE=F,SOFI,PLTR,NIO,AMD,INTC,T,BAC,PFE,CSCO,HOOD,RIVN,SNAP,UBER,WBD,GRAB,VALE,RIG,CCL,KVUE
BAR_TIMEFRAME=1Day          # 1Day = swing; 15Min/5Min = intraday
LOOKBACK_DAYS=400

# ===== Google Sheets (optional) =====
GSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# ===== Storage =====
DB_PATH=microbot.db
